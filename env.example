# CoinGecko API Key (for cryptocurrency data)
# Get your free API key at: https://www.coingecko.com/en/api
COINGECKO_API_KEY=your_coingecko_api_key_here

# FMP (Financial Modeling Prep) API Key (for stock market data)
# Get your free API key at: https://site.financialmodelingprep.com/register
FMP_API_KEY=your_fmp_api_key_here

# Alpha Vantage API Key (alternative stock data provider)
# Get your free API key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# OpenAI API Key (for AI Stock Assistant feature)
# Get your API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# FRED API Key (for economic indicators - inflation, unemployment, etc.)
# Get your free API key at: https://fred.stlouisfed.org/
FRED_API_KEY=your_fred_api_key_here

# Site URL (for metadata, Open Graph, and footer links). Use your production domain.
# Example: https://yourdomain.com or https://financeplatform-xxx.vercel.app
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Note: Copy this file to .env.local and fill in your actual API keys
# Never commit .env.local to version control!

